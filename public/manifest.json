{
  "manifest_version": 3,
  "name": "Meet & X Recorder",
  "version": "1.1.0",
  "description": "Record tab video, tab audio and microphone independently. Files stay on this device.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Meet & X Recorder"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
